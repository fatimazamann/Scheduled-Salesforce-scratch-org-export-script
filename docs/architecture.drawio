<mxfile host="app.diagrams.net" agent="design-doc" type="device">
  <diagram id="arch" name="1. Architecture">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="laptop" value="Windows machine  —  runs as ONE Windows account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#8fa3b8;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="640" height="720" as="geometry" />
        </mxCell>

        <mxCell id="cloud" value="Salesforce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#4a90d9;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="200" width="330" height="330" as="geometry" />
        </mxCell>

        <mxCell id="sched" value="&lt;b&gt;Windows Task Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;daily 20:00, run as the account&lt;br&gt;that authenticated the orgs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="bat" value="&lt;b&gt;scheduled-export.bat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;~40 lines, no logic&lt;br&gt;anchor cwd · optional set-env.cmd&lt;br&gt;check node · propagate exit code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="195" width="250" height="72" as="geometry" />
        </mxCell>

        <mxCell id="orch" value="&lt;b&gt;orchestrator.js&lt;/b&gt;&amp;nbsp;&amp;nbsp;(once per RUN)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;preflight · discover orgs · eligibility&lt;br&gt;take run lock · sequential loop&lt;br&gt;retry transient only · atomic swap&lt;br&gt;logs, summary, exit code · prune&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="305" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="child" value="&lt;b&gt;export-script.js&lt;/b&gt;&amp;nbsp;&amp;nbsp;(once per ORG)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;verify auth · 4 SOQL queries&lt;br&gt;clean · metadata retrieve&lt;br&gt;_export-summary.json&lt;br&gt;exit codes 0–6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="450" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="clean" value="&lt;b&gt;clean-json.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;strips audit fields so the export&lt;br&gt;stays re-importable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="595" width="250" height="56" as="geometry" />
        </mxCell>

        <mxCell id="lib" value="&lt;b&gt;lib/&lt;/b&gt;&amp;nbsp;&amp;nbsp;zero dependencies&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;sf-cli&lt;/b&gt; arg arrays, Windows shim resolution&lt;br&gt;&lt;b&gt;config&lt;/b&gt; defaults → file → env → flags&lt;br&gt;&lt;b&gt;logger&lt;/b&gt; allowlist: tokens cannot leak&lt;br&gt;&lt;b&gt;lock&lt;/b&gt; single instance, stale reclaim&lt;br&gt;&lt;b&gt;soql&lt;/b&gt; literal escaping&amp;nbsp;&amp;nbsp;&lt;b&gt;args&lt;/b&gt; parser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="305" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="&lt;b&gt;Salesforce CLI (sf v2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;invoked as node run.js — no shell&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="465" width="280" height="56" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;%USERPROFILE%\.sfdx&lt;/b&gt;&amp;nbsp;&amp;nbsp;auth store&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PER WINDOWS ACCOUNT.&lt;br&gt;Wrong run-as account = 0 orgs found, exit 0.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="370" y="100" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="work" value="&lt;b&gt;.metadata-work/&lt;/b&gt;&amp;nbsp;&amp;nbsp;scratch SFDX project&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;retrieve target — OUTSIDE the export tree&lt;br&gt;cleared before every org&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="565" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="out" value="&lt;b&gt;connectjunction-exports/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cj-export_&amp;lt;alias&amp;gt;/ — one per org, replaced nightly&lt;br&gt;data JSON + metadata/ + _export-summary.json&lt;/font&gt;&lt;br&gt;&lt;b&gt;logs/&lt;/b&gt;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot;&gt;run log, summary, latest.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="660" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="org1" value="scratch org&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;*.scratch.my.salesforce.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a90d9;" vertex="1" parent="1">
          <mxGeometry x="770" y="250" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="org2" value="scratch org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a90d9;" vertex="1" parent="1">
          <mxGeometry x="770" y="315" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="org3" value="&lt;font color=&quot;#999999&quot;&gt;production / sandbox / Dev Hub&lt;br&gt;&lt;b&gt;NEVER TOUCHED&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="370" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="devhub" value="&lt;b&gt;Dev Hub&lt;/b&gt; → ScratchOrgInfo&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;source of expirationDate / status / isExpired&lt;br&gt;absent for orgs authorised via login web&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="770" y="440" width="270" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;" edge="1" parent="1" source="sched" target="bat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;" edge="1" parent="1" source="bat" target="orch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="one child process per eligible org" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="orch" target="child"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;" edge="1" parent="1" source="child" target="clean"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="org list, sobject describe" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="orch" target="cli"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="data export tree&#10;project retrieve start" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="child" target="cli"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="reads" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="cli" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;" edge="1" parent="1" source="cli" target="org1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="retrieves into" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="cli" target="work"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="moved in" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="work" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="clean" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="orch" target="lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="child" target="lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="queried by sf org list" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="devhub" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="flow" name="2. Per-org decision flow">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="f0" />
        <mxCell id="f1" parent="f0" />

        <mxCell id="start" value="sf org list --json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="f1"><mxGeometry x="360" y="40" width="220" height="40" as="geometry" /></mxCell>

        <mxCell id="d1" value="scratch org?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;isScratch flag&amp;nbsp;OR&amp;nbsp;scratchOrgs bucket&lt;br&gt;OR *.scratch.my.salesforce.com&lt;br&gt;(explicit sandbox/DevHub always wins)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="330" y="120" width="280" height="120" as="geometry" /></mxCell>

        <mxCell id="d2" value="expired?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;isExpired · status ≠ Active&lt;br&gt;expirationDate passed&lt;br&gt;&amp;lt; minHoursUntilExpiry&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="330" y="280" width="280" height="110" as="geometry" /></mxCell>

        <mxCell id="d3" value="reachable AND has&lt;br&gt;cja_cj__CJ_Connector__c ?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one sf sobject describe —&lt;br&gt;metadata only, so an empty org still exports&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="330" y="430" width="280" height="130" as="geometry" /></mxCell>

        <mxCell id="a1" value="export into&lt;br&gt;&lt;b&gt;.tmp_&amp;lt;folder&amp;gt;_&amp;lt;runId&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4 SOQL query sets → sf data export tree --plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="345" y="600" width="250" height="70" as="geometry" /></mxCell>

        <mxCell id="a2" value="clean-json.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;strip audit fields&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="345" y="700" width="250" height="50" as="geometry" /></mxCell>

        <mxCell id="a3" value="truncation check&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;record count EXACTLY at a limit = warn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="345" y="780" width="250" height="50" as="geometry" /></mxCell>

        <mxCell id="d4" value="metadata enabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="370" y="860" width="200" height="70" as="geometry" /></mxCell>

        <mxCell id="a4" value="retrieve into &lt;b&gt;.metadata-work/retrieved&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cleared first · --json · then MOVED into the backup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="330" y="960" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="d5" value="metadata failed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="370" y="1050" width="200" height="70" as="geometry" /></mxCell>

        <mxCell id="a5" value="&lt;b&gt;swapIntoPlace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rename old aside → rename temp in → delete old&lt;br&gt;a failed run never damages the previous backup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="330" y="1160" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="ok" value="&lt;b&gt;SUCCESS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="395" y="1250" width="150" height="40" as="geometry" /></mxCell>

        <mxCell id="s1" value="not discovered&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;never contacted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="f1"><mxGeometry x="720" y="150" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="s2" value="SKIPPED_EXPIRED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="f1"><mxGeometry x="720" y="310" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="s3" value="SKIPPED_UNREACHABLE&lt;br&gt;SKIPPED_APP_NOT_INSTALLED&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a skip is not a failure — exit code stays 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="f1"><mxGeometry x="720" y="465" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="s4" value="report it, KEEP the data export&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;metadata: FAILED in the summary&lt;br&gt;failureIsFatal=true flips this&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="f1"><mxGeometry x="680" y="1045" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="s5" value="&lt;b&gt;FAILED&lt;/b&gt; — temp folder discarded,&lt;br&gt;previous backup untouched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="f1"><mxGeometry x="60" y="600" width="230" height="60" as="geometry" /></mxCell>

        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="start" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d1" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d2" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe5" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe6" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d3" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe7" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d3" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe8" value="export or clean fails" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="a1" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe12" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d4" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe14" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d5" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe15" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d5" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="s4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a5" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe18" value="no (skip)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="f1" source="d4" target="a5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="895" /><mxPoint x="250" y="1190" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
