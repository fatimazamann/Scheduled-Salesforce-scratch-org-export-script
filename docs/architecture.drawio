<mxfile host="app.diagrams.net" agent="design-doc" type="device">
  <diagram id="arch" name="1. Architecture">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="laptop" value="Windows machine  —  runs as ONE Windows account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7fa;strokeColor=#8fa3b8;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="640" height="720" as="geometry" />
        </mxCell>

        <mxCell id="cloud" value="Salesforce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#4a90d9;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="200" width="330" height="330" as="geometry" />
        </mxCell>

        <mxCell id="sched" value="&lt;b&gt;Windows Task Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;daily 20:00, run as the account&lt;br&gt;that authenticated the orgs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="250" height="60" as="geometry" />
        </mxCell>

        <mxCell id="bat" value="&lt;b&gt;scheduled-export.bat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;~40 lines, no logic&lt;br&gt;anchor cwd · optional set-env.cmd&lt;br&gt;check node · propagate exit code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="195" width="250" height="72" as="geometry" />
        </mxCell>

        <mxCell id="orch" value="&lt;b&gt;orchestrator.js&lt;/b&gt;&amp;nbsp;&amp;nbsp;(once per RUN)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;preflight · discover orgs · eligibility&lt;br&gt;take run lock · sequential loop&lt;br&gt;retry transient only · atomic swap&lt;br&gt;logs, summary, exit code · prune&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="305" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="child" value="&lt;b&gt;export-script.js&lt;/b&gt;&amp;nbsp;&amp;nbsp;(once per ORG)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;verify auth · 4 SOQL queries&lt;br&gt;clean · metadata retrieve&lt;br&gt;_export-summary.json&lt;br&gt;exit codes 0–6&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="450" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="clean" value="&lt;b&gt;clean-json.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;strips audit fields so the export&lt;br&gt;stays re-importable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="595" width="250" height="56" as="geometry" />
        </mxCell>

        <mxCell id="lib" value="&lt;b&gt;lib/&lt;/b&gt;&amp;nbsp;&amp;nbsp;zero dependencies&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;sf-cli&lt;/b&gt; arg arrays, Windows shim resolution&lt;br&gt;&lt;b&gt;config&lt;/b&gt; defaults → file → env → flags&lt;br&gt;&lt;b&gt;logger&lt;/b&gt; allowlist: tokens cannot leak&lt;br&gt;&lt;b&gt;lock&lt;/b&gt; single instance, stale reclaim&lt;br&gt;&lt;b&gt;soql&lt;/b&gt; literal escaping&amp;nbsp;&amp;nbsp;&lt;b&gt;args&lt;/b&gt; parser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="305" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="&lt;b&gt;Salesforce CLI (sf v2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;invoked as node run.js — no shell&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="465" width="280" height="56" as="geometry" />
        </mxCell>

        <mxCell id="auth" value="&lt;b&gt;%USERPROFILE%\.sfdx&lt;/b&gt;&amp;nbsp;&amp;nbsp;auth store&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;PER WINDOWS ACCOUNT.&lt;br&gt;Wrong run-as account = 0 orgs found, exit 0.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="370" y="100" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="work" value="&lt;b&gt;.metadata-work/&lt;/b&gt;&amp;nbsp;&amp;nbsp;scratch SFDX project&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;retrieve target — OUTSIDE the export tree&lt;br&gt;cleared before every org&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="370" y="565" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="out" value="&lt;b&gt;connectjunction-exports/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cj-export_&amp;lt;alias&amp;gt;/ — one per org, replaced nightly&lt;br&gt;data JSON + metadata/ + _export-summary.json&lt;/font&gt;&lt;br&gt;&lt;b&gt;logs/&lt;/b&gt;&amp;nbsp;&lt;font style=&quot;font-size:11px&quot;&gt;run log, summary, latest.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="370" y="660" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="org1" value="scratch org&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;*.scratch.my.salesforce.com&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a90d9;" vertex="1" parent="1">
          <mxGeometry x="770" y="250" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="org2" value="scratch org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a90d9;" vertex="1" parent="1">
          <mxGeometry x="770" y="315" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="org3" value="&lt;font color=&quot;#999999&quot;&gt;production / sandbox / Dev Hub&lt;br&gt;&lt;b&gt;NEVER TOUCHED&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="770" y="370" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="devhub" value="&lt;b&gt;Dev Hub&lt;/b&gt; → ScratchOrgInfo&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;source of expirationDate / status / isExpired&lt;br&gt;absent for orgs authorised via login web&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="770" y="440" width="270" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;" edge="1" parent="1" source="sched" target="bat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;" edge="1" parent="1" source="bat" target="orch"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="one child process per eligible org" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="orch" target="child"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;" edge="1" parent="1" source="child" target="clean"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="org list, sobject describe" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="orch" target="cli"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="data export tree&#10;project retrieve start" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="child" target="cli"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="reads" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="cli" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;" edge="1" parent="1" source="cli" target="org1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="retrieves into" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="cli" target="work"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="moved in" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="work" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;" edge="1" parent="1" source="clean" target="out"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="orch" target="lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=none;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="child" target="lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" value="queried by sf org list" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;fontSize=10;dashed=1;" edge="1" parent="1" source="devhub" target="auth"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="flow" name="2. Per-org decision flow">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="f0" />
        <mxCell id="f1" parent="f0" />

        <mxCell id="start" value="sf org list --json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="f1"><mxGeometry x="360" y="40" width="220" height="40" as="geometry" /></mxCell>

        <mxCell id="d1" value="scratch org?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;isScratch flag&amp;nbsp;OR&amp;nbsp;scratchOrgs bucket&lt;br&gt;OR *.scratch.my.salesforce.com&lt;br&gt;(explicit sandbox/DevHub always wins)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="330" y="120" width="280" height="120" as="geometry" /></mxCell>

        <mxCell id="d2" value="expired?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;isExpired · status ≠ Active&lt;br&gt;expirationDate passed&lt;br&gt;&amp;lt; minHoursUntilExpiry&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="330" y="280" width="280" height="110" as="geometry" /></mxCell>

        <mxCell id="d3" value="reachable AND has&lt;br&gt;cja_cj__CJ_Connector__c ?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one sf sobject describe —&lt;br&gt;metadata only, so an empty org still exports&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="330" y="430" width="280" height="130" as="geometry" /></mxCell>

        <mxCell id="a1" value="export into&lt;br&gt;&lt;b&gt;.tmp_&amp;lt;folder&amp;gt;_&amp;lt;runId&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4 SOQL query sets → sf data export tree --plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="345" y="600" width="250" height="70" as="geometry" /></mxCell>

        <mxCell id="a2" value="clean-json.js&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;strip audit fields&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="345" y="700" width="250" height="50" as="geometry" /></mxCell>

        <mxCell id="a3" value="truncation check&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;record count EXACTLY at a limit = warn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="345" y="780" width="250" height="50" as="geometry" /></mxCell>

        <mxCell id="d4" value="metadata enabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="370" y="860" width="200" height="70" as="geometry" /></mxCell>

        <mxCell id="a4" value="retrieve into &lt;b&gt;.metadata-work/retrieved&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cleared first · --json · then MOVED into the backup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="330" y="960" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="d5" value="metadata failed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="f1"><mxGeometry x="370" y="1050" width="200" height="70" as="geometry" /></mxCell>

        <mxCell id="a5" value="&lt;b&gt;swapIntoPlace&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rename old aside → rename temp in → delete old&lt;br&gt;a failed run never damages the previous backup&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="f1"><mxGeometry x="330" y="1160" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="ok" value="&lt;b&gt;SUCCESS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="f1"><mxGeometry x="395" y="1250" width="150" height="40" as="geometry" /></mxCell>

        <mxCell id="s1" value="not discovered&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;never contacted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="f1"><mxGeometry x="720" y="150" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="s2" value="SKIPPED_EXPIRED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="f1"><mxGeometry x="720" y="310" width="200" height="40" as="geometry" /></mxCell>
        <mxCell id="s3" value="SKIPPED_UNREACHABLE&lt;br&gt;SKIPPED_APP_NOT_INSTALLED&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a skip is not a failure — exit code stays 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="f1"><mxGeometry x="720" y="465" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="s4" value="report it, KEEP the data export&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;metadata: FAILED in the summary&lt;br&gt;failureIsFatal=true flips this&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="f1"><mxGeometry x="680" y="1045" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="s5" value="&lt;b&gt;FAILED&lt;/b&gt; — temp folder discarded,&lt;br&gt;previous backup untouched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="f1"><mxGeometry x="60" y="600" width="230" height="60" as="geometry" /></mxCell>

        <mxCell id="fe1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="start" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe2" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d1" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe3" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe4" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d2" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe5" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe6" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d3" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe7" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d3" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe8" value="export or clean fails" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="a1" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe12" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d4" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe14" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d5" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe15" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="f1" source="d5" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="s4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe17" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="f1" source="a5" target="ok"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="fe18" value="no (skip)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="f1" source="d4" target="a5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="895" /><mxPoint x="250" y="1190" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="runflow" name="3. Run execution flow (parent)">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="r0" /><mxCell id="r1" parent="r0" />

        <mxCell id="rs" value="Task Scheduler fires" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="r1"><mxGeometry x="360" y="30" width="240" height="50" as="geometry" /></mxCell>

        <mxCell id="rbat" value="&lt;b&gt;scheduled-export.bat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;1 pushd %~dp0&amp;nbsp;&amp;nbsp;2 call set-env.cmd if present&lt;br&gt;3 where node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="r1"><mxGeometry x="360" y="110" width="240" height="60" as="geometry" /></mxCell>

        <mxCell id="rcfg" value="parseArgs → loadConfig&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DEFAULTS → json file → SFEXPORT_* → flags&lt;br&gt;all paths resolved vs project root&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="r1"><mxGeometry x="360" y="200" width="240" height="60" as="geometry" /></mxCell>

        <mxCell id="rpre" value="&lt;b&gt;preflight()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;node version + path&lt;br&gt;resolve sf (prefer .exe, then .cmd, never .ps1)&lt;br&gt;auto-discover run.js → no shell&lt;br&gt;exportScript + cleanScript exist&lt;br&gt;exportRoot + logRoot writable (probe file)&lt;br&gt;metadata manifest parses, count types/members&lt;br&gt;sf --version actually executes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="r1"><mxGeometry x="360" y="290" width="240" height="120" as="geometry" /></mxCell>

        <mxCell id="rlock" value="acquire run lock&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fs.openSync(path,&#39;wx&#39;) — atomic&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="r1"><mxGeometry x="380" y="440" width="200" height="90" as="geometry" /></mxCell>

        <mxCell id="rstale" value="held — but stale?&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PID dead OR older than&lt;br&gt;lockStaleMinutes&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="r1"><mxGeometry x="700" y="440" width="200" height="90" as="geometry" /></mxCell>

        <mxCell id="rsweep" value="cleanStaleWorkDirs()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;remove .tmp_* and *.old_* from a killed run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="r1"><mxGeometry x="360" y="560" width="240" height="50" as="geometry" /></mxCell>

        <mxCell id="rdisc" value="&lt;b&gt;sf org list --json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;scratchOrgs bucket, else scan all buckets&lt;br&gt;NOT --all: expired orgs stay hidden&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="r1"><mxGeometry x="360" y="640" width="240" height="60" as="geometry" /></mxCell>

        <mxCell id="rloopl" value="&lt;b&gt;for each discovered org — SEQUENTIALLY&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;fontSize=11;fontStyle=1;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="r1"><mxGeometry x="300" y="730" width="360" height="330" as="geometry" /></mxCell>

        <mxCell id="rclass" value="classifyOrg + package probe&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;→ see page 2 for the gates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="r1"><mxGeometry x="330" y="765" width="300" height="50" as="geometry" /></mxCell>

        <mxCell id="rdry" value="dryRun?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="r1"><mxGeometry x="400" y="835" width="160" height="60" as="geometry" /></mxCell>

        <mxCell id="rchild" value="spawn &lt;b&gt;export-script.js&lt;/b&gt; → page 4&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;into .tmp_&amp;lt;folder&amp;gt;_&amp;lt;runId&amp;gt;&lt;br&gt;timeout = childTimeout + metadataTimeout + 60s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="r1"><mxGeometry x="330" y="915" width="300" height="60" as="geometry" /></mxCell>

        <mxCell id="rretry" value="exit 6 or timed out,&lt;br&gt;and attempts left?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="r1"><mxGeometry x="360" y="995" width="240" height="55" as="geometry" /></mxCell>

        <mxCell id="rbackoff" value="wait retryBackoffSeconds&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;15s, then 45s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="r1"><mxGeometry x="90" y="925" width="180" height="50" as="geometry" /></mxCell>

        <mxCell id="rmd" value="read metadata result from&lt;br&gt;the child&#39;s _export-summary.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="r1"><mxGeometry x="360" y="1090" width="240" height="50" as="geometry" /></mxCell>

        <mxCell id="rswap" value="&lt;b&gt;swapIntoPlace()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;only a fully successful export replaces&lt;br&gt;what is already on disk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="r1"><mxGeometry x="360" y="1170" width="240" height="60" as="geometry" /></mxCell>

        <mxCell id="rdisc2" value="discard temp folder&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;best-effort — a failed delete&lt;br&gt;NEVER aborts the run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="r1"><mxGeometry x="700" y="1170" width="220" height="60" as="geometry" /></mxCell>

        <mxCell id="rrel" value="release lock  ·  prune logs + exports by retention&lt;br&gt;write export_&amp;lt;runId&amp;gt;.log / .json  ·  latest.json  ·  print summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#6c8ebf;" vertex="1" parent="r1"><mxGeometry x="310" y="1270" width="340" height="60" as="geometry" /></mxCell>

        <mxCell id="rexit" value="any org FAILED?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="r1"><mxGeometry x="390" y="1360" width="180" height="60" as="geometry" /></mxCell>

        <mxCell id="rx0" value="&lt;b&gt;exit 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;all eligible exported&lt;br&gt;(including none found)&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="r1"><mxGeometry x="300" y="1460" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="rx1" value="&lt;b&gt;exit 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;partial failure&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="r1"><mxGeometry x="500" y="1460" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="rx2" value="&lt;b&gt;exit 2&lt;/b&gt;  preflight / config / discovery&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NO orgs were processed&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="r1"><mxGeometry x="700" y="270" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="rx3" value="&lt;b&gt;exit 3&lt;/b&gt;  another run active&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;did nothing — not a failure&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="r1"><mxGeometry x="960" y="455" width="190" height="60" as="geometry" /></mxCell>

        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="rs" target="rbat"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="rbat" target="rcfg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="rcfg" target="rpre"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re4" value="node missing" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#b85450;" edge="1" parent="r1" source="rbat" target="rx2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re5" value="any check fails" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#b85450;" edge="1" parent="r1" source="rpre" target="rx2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re6" value="ok" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rpre" target="rlock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re7" value="already held" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rlock" target="rstale"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re8" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;" edge="1" parent="r1" source="rstale" target="rx3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re9" value="yes — reclaim, warn" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rstale" target="rsweep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re10" value="acquired" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rlock" target="rsweep"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="rsweep" target="rdisc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re12" value="org list fails" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#b85450;" edge="1" parent="r1" source="rdisc" target="rx2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="rdisc" target="rclass"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="rclass" target="rdry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re15" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rdry" target="rchild"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="rchild" target="rretry"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re17" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;" edge="1" parent="r1" source="rretry" target="rbackoff"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re18" value="retry" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#d79b00;" edge="1" parent="r1" source="rbackoff" target="rchild"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re19" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rretry" target="rmd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re20" value="child exit 0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rmd" target="rswap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re21" value="child exit 1–5,&#10;or swap failed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#b85450;" edge="1" parent="r1" source="rmd" target="rdisc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re22" value="next org" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rswap" target="rrel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rdisc2" target="rrel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re24" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="r1" source="rrel" target="rexit"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re25" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rexit" target="rx0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re26" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rexit" target="rx1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="re27" value="yes — log the command,&#10;export nothing" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;" edge="1" parent="r1" source="rdry" target="rrel"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="865" /><mxPoint x="250" y="1300" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="childflow" name="4. Child execution flow (one org)">
    <mxGraphModel dx="1200" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="c0" /><mxCell id="c1" parent="c0" />

        <mxCell id="cs" value="export-script.js  &amp;lt;one org&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1" vertex="1" parent="c1"><mxGeometry x="330" y="30" width="280" height="50" as="geometry" /></mxCell>

        <mxCell id="cval" value="&lt;b&gt;validate every flag — before any I/O&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;org type · username format · --dir present&lt;br&gt;integration type · connector names printable&lt;br&gt;limit ≤ 200 · timeouts &amp;gt; 0 · manifest exists&lt;br&gt;--interactive refused for scratch orgs&lt;br&gt;sf paths pinned ABSOLUTE (cwd moves later)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="c1"><mxGeometry x="330" y="110" width="280" height="105" as="geometry" /></mxCell>

        <mxCell id="cauth" value="&lt;b&gt;sf org display&lt;/b&gt; — verify stored auth&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;deliberately WITHOUT --verbose:&lt;br&gt;that returns sfdxAuthUrl, a refresh token&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c1"><mxGeometry x="330" y="250" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="cq" value="&lt;b&gt;buildQueries()&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CJ Connectors (+ escaped connector filter)&lt;br&gt;JSON Object Mappings + field-mapping subquery&lt;br&gt;Message Templates&lt;br&gt;Dataflows + actions + action data — any-to-any ONLY&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;" vertex="1" parent="c1"><mxGeometry x="330" y="345" width="280" height="85" as="geometry" /></mxCell>

        <mxCell id="cexp" value="&lt;b&gt;sf data export tree --plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one --query per set · --output-dir as ONE argv element&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c1"><mxGeometry x="330" y="465" width="280" height="55" as="geometry" /></mxCell>

        <mxCell id="ctr" value="detectTruncation()&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;count EXACTLY at 200 or 2000 → warn&lt;br&gt;a count merely above the limit is normal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c1"><mxGeometry x="330" y="555" width="280" height="55" as="geometry" /></mxCell>

        <mxCell id="ccl" value="&lt;b&gt;clean-json.js&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;strip audit fields — not cosmetic:&lt;br&gt;they are not insertable, so this keeps it importable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c1"><mxGeometry x="330" y="645" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="cmdq" value="metadata enabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c1"><mxGeometry x="380" y="740" width="180" height="60" as="geometry" /></mxCell>

        <mxCell id="cmdw" value="prepare &lt;b&gt;.metadata-work/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rm retrieved/ (or the LAST org&#39;s files leak in)&lt;br&gt;write sfdx-project.json, package dir = force-app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c1"><mxGeometry x="330" y="830" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="cmdr" value="&lt;b&gt;sf project retrieve start --json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;cwd = .metadata-work (NEVER the export folder)&lt;br&gt;--output-dir retrieved (relative, no overlap)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="c1"><mxGeometry x="330" y="920" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="cmdmv" value="MOVE retrieved/ → &amp;lt;export&amp;gt;/metadata&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;rename; cpSync fallback on EXDEV&lt;br&gt;log each manifest warning individually&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="c1"><mxGeometry x="330" y="1010" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="cmdf" value="retrieve failed&lt;br&gt;AND --metadata-required?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="c1"><mxGeometry x="700" y="915" width="220" height="80" as="geometry" /></mxCell>

        <mxCell id="cmdk" value="warn and KEEP the data export&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;metadata: FAILED in the summary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="c1"><mxGeometry x="690" y="1030" width="240" height="50" as="geometry" /></mxCell>

        <mxCell id="csum" value="write &lt;b&gt;_export-summary.json&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;the exact SOQL · truncation findings&lt;br&gt;metadata block · timings · status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#6c8ebf;" vertex="1" parent="c1"><mxGeometry x="330" y="1110" width="280" height="60" as="geometry" /></mxCell>

        <mxCell id="cx0" value="&lt;b&gt;exit 0&lt;/b&gt;  SUCCESS" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="c1"><mxGeometry x="380" y="1210" width="180" height="50" as="geometry" /></mxCell>

        <mxCell id="cx2" value="&lt;b&gt;exit 2&lt;/b&gt; INVALID_ARGUMENTS&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;never retried&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c1"><mxGeometry x="700" y="130" width="230" height="55" as="geometry" /></mxCell>
        <mxCell id="cx3" value="&lt;b&gt;exit 3&lt;/b&gt; AUTH&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&lt;b&gt;exit 6&lt;/b&gt; TRANSIENT&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;no browser login is ever attempted&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c1"><mxGeometry x="690" y="250" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="cx4" value="&lt;b&gt;exit 4&lt;/b&gt; EXPORT_FAILED&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;malformed query, missing object — never retried&lt;br&gt;&lt;b&gt;exit 6&lt;/b&gt; if network / 5xx / limit&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c1"><mxGeometry x="680" y="455" width="270" height="70" as="geometry" /></mxCell>
        <mxCell id="cx5" value="&lt;b&gt;exit 5&lt;/b&gt; CLEANUP_FAILED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="c1"><mxGeometry x="700" y="650" width="230" height="50" as="geometry" /></mxCell>

        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="c1" source="cs" target="cval"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" value="bad flag" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=10;strokeColor=#b85450;" edge="1" parent="c1" source="cval" target="cx2"><mxGeometry relative="1" as="geometry" /></mxCell>
